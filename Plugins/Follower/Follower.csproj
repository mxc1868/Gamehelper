<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../GameHelper/GameHelper.csproj" Private="false" />
  </ItemGroup>
  <Target Name="CopyPlugin" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)$(TargetName).dll;$(OutDir)$(TargetName).pdb"
          DestinationFolder="../../GameHelper/$(OutDir)Plugins/Follower" SkipUnchangedFiles="true" />
  </Target>
</Project>
