<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../GameHelper/GameHelper.csproj" Private="false" />
    <ProjectReference Include="../../Modules/Combat/Combat.csproj" />
    <EmbeddedResource Include="Web/wwwroot/*" />
  </ItemGroup>
  <Target Name="CopyPlugin" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)$(TargetName).dll;$(OutDir)$(TargetName).pdb;$(OutDir)$(TargetName).deps.json;$(OutDir)BloodyBot.Combat.dll;$(OutDir)BloodyBot.Combat.pdb"
          DestinationFolder="../../GameHelper/$(OutDir)Plugins/Bloodybot2" SkipUnchangedFiles="true" />
    <!-- Retire the old entry assembly in incremental host outputs; keep legacy config for migration. -->
    <Delete Files="../../GameHelper/$(OutDir)Plugins/Follower/Follower.dll;../../GameHelper/$(OutDir)Plugins/Follower/Follower.pdb;../../GameHelper/$(OutDir)Plugins/Follower/Follower.deps.json" />
  </Target>
</Project>
