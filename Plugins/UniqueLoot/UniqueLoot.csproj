<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../GameHelper/GameHelper.csproj" Private="false" />
    <EmbeddedResource Include="Data/uniqueArtMapping.json" LogicalName="UniqueLoot.ArtMapping" />
    <None Update="Localization/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyPlugin" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)$(TargetName).dll;$(OutDir)$(TargetName).pdb"
          DestinationFolder="../../GameHelper/$(OutDir)Plugins/UniqueLoot" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(None->WithMetadataValue('Extension', '.json'))"
          DestinationFolder="../../GameHelper/$(OutDir)Plugins/UniqueLoot/Localization" SkipUnchangedFiles="true"
          Condition="'%(None.CopyToOutputDirectory)' == 'PreserveNewest'" />
  </Target>
</Project>
