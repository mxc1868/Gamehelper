<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier></RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Modules/Combat/Combat.csproj" />
    <Compile Include="../../Plugins/Bloodybot2/Configuration/*.cs" Link="Configuration/%(Filename)%(Extension)" />
    <Compile Include="../../Plugins/Bloodybot2/Runtime/*.cs" Link="Runtime/%(Filename)%(Extension)" />
    <Compile Include="../../Plugins/Bloodybot2/Web/WebConfigServer.cs" Link="Web/WebConfigServer.cs" />
    <EmbeddedResource Include="../../Plugins/Bloodybot2/Web/wwwroot/*" LogicalName="Bloodybot2.Web.wwwroot.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
